  "panels": [
    {
      "id": 1,
      "title": "Общий статус",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "safeboard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "spanNulls": false
          },
          "min": 0,
          "max": 1,
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Всё плохо",
                  "color": "red"
                },
                "1": {
                  "text": "Всё хорошо",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Нет данных",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "safeboard:platform_ok",
          "legendFormat": "{{service}} {{instance}} {{container_label_com_docker_compose_service}}",
          "instant": true,
          "range": false
        }
      ]
    },
