{
  "id": null,
  "uid": "safeboard-health",
  "title": "Safeboard — здоровье контура",
  "tags": [
    "safeboard",
    "dagger"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 0,
  "refresh": "5s",
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
