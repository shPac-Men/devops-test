{
  "dashboard": {
    "uid": "safeboard-health",
    "id": null,
    "title": "Safeboard · здоровье контура",
    "description": "Ресурсы Linux-хоста и контейнеров, состояние MariaDB и HTTP-доступность Uptime Kuma. HTTP-проба не проверяет внутренние мониторы Kuma.",
    "tags": [
      "safeboard"
    ],
    "schemaVersion": 41,
    "version": 0,
    "editable": true,
    "timezone": "browser",
    "refresh": "15s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "MariaDB",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "safeboard-prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 8,
          "h": 4
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "color": {
              "mode": "thresholds"
            },
            "noValue": "Нет данных",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "Проблема",
                    "color": "red"
                  },
                  "1": {
                    "text": "OK",
                    "color": "green"
                  }
                }
              }
            ]
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "(min(mysql_up{job=\"mariadb\"}) or vector(0)) * (min(up{job=\"mariadb\"}) or vector(0))",
            "datasource": {
              "type": "prometheus",
              "uid": "safeboard-prometheus"
            },
            "legendFormat": "{{instance}}",
            "range": false,
            "instant": true
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "auto"
        }
      },
